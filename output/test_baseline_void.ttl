            void1:entities "2"^^xsd1:integer ],
        [ void1:class_ schema:Researcher ;
            void1:entities "2"^^xsd1:integer ],
        [ void1:class_ schema:Dataset ;
            void1:entities "3"^^xsd1:integer ] ;
    void1:classes "3"^^xsd1:integer ;
    void1:distinctObjects "8"^^xsd1:integer ;
    void1:distinctSubjects "7"^^xsd1:integer ;
    void1:properties "8"^^xsd1:integer ;
    void1:triples "14"^^xsd1:integer .

