@prefix xsd1: <https://schema.org/xsd#> .

<http://purls.helmholtz-metadaten.de/helmholtzkg/test_baseline.ttl> a void1:Dataset ;
    dcterms1:title "Topological Profile for test_baseline.ttl"@en ;
