@prefix dcterms1: <https://schema.org/dcterms#> .
@prefix schema: <https://schema.org/> .
@prefix void1: <https://schema.org/void#> .
@prefix xsd1: <https://schema.org/xsd#> .

<http://purls.helmholtz-metadaten.de/helmholtzkg/type_only_graph.ttl> a void1:Dataset ;
    dcterms1:title "Topological Profile for type_only_graph.ttl"@en ;
    void1:classPartition [ void1:class_ schema:Dataset ;
            void1:entities "1"^^xsd1:integer ],
        [ void1:class_ schema:Project ;
            void1:entities "1"^^xsd1:integer ],
        [ void1:class_ schema:Person ;
            void1:entities "1"^^xsd1:integer ] ;
    void1:classes "3"^^xsd1:integer ;
    void1:distinctObjects "3"^^xsd1:integer ;
    void1:distinctSubjects "3"^^xsd1:integer ;
    void1:properties "1"^^xsd1:integer ;
    void1:triples "3"^^xsd1:integer .

