@prefix dcterms1: <https://schema.org/dcterms#> .
@prefix schema: <https://schema.org/> .
@prefix void1: <https://schema.org/void#> .
@prefix xsd1: <https://schema.org/xsd#> .

<http://purls.helmholtz-metadaten.de/helmholtzkg/multi_type_entity.ttl> a void1:Dataset ;
    dcterms1:title "Topological Profile for multi_type_entity.ttl"@en ;
    void1:classPartition [ void1:class_ schema:SoftwareEngineer ;
            void1:entities "1"^^xsd1:integer ],
        [ void1:class_ schema:ProjectLead ;
            void1:entities "1"^^xsd1:integer ],
        [ void1:class_ schema:Researcher ;
            void1:entities "2"^^xsd1:integer ] ;
    void1:classes "3"^^xsd1:integer ;
    void1:distinctObjects "3"^^xsd1:integer ;
    void1:distinctSubjects "2"^^xsd1:integer ;
    void1:properties "1"^^xsd1:integer ;
    void1:triples "4"^^xsd1:integer .

