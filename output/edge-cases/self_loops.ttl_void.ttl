@prefix dcterms1: <https://schema.org/dcterms#> .
@prefix schema: <https://schema.org/> .
@prefix void1: <https://schema.org/void#> .
@prefix xsd1: <https://schema.org/xsd#> .

<http://purls.helmholtz-metadaten.de/helmholtzkg/self_loops.ttl> a void1:Dataset ;
    dcterms1:title "Topological Profile for self_loops.ttl"@en ;
    void1:classPartition [ void1:class_ schema:Process ;
            void1:entities "2"^^xsd1:integer ] ;
    void1:classes "1"^^xsd1:integer ;
    void1:distinctObjects "3"^^xsd1:integer ;
    void1:distinctSubjects "2"^^xsd1:integer ;
    void1:properties "3"^^xsd1:integer ;
    void1:triples "4"^^xsd1:integer .

